# 环境变量模板：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，禁止提交）
# 所有变量均有代码级默认值，仅密钥类为必填。

# ---------- 必填 ----------
# DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxx
# JWT 签名密钥（HS256，至少 32 字节；生成示例：openssl rand -base64 48；缺失时应用拒绝启动）
JWT_SECRET=change-me-please-openssl-rand-base64-48
# 数据库密码（本地开发默认 root/空，生产必填）
DB_PASSWORD=change-me

# ---------- 可选 ----------
# 数据库连接（默认 jdbc:mysql://127.0.0.1:3306/langchain4j?...）
# DB_URL=jdbc:mysql://127.0.0.1:3306/langchain4j?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false
# DB_USERNAME=root

# Redis Stack 密码（本地无密码则留空）
# REDIS_PASSWORD=
# KB_REDIS_HOST=127.0.0.1
# KB_REDIS_PORT=6379

# 重排模型路径（默认指向项目内 models/bge-reranker-base-int8/；容器部署挂载 /models 时覆盖）
# KB_RERANK_MODEL_PATH=/models/bge-reranker-base-int8/model_quantized.onnx
# KB_RERANK_TOKENIZER_PATH=/models/bge-reranker-base-int8/tokenizer.json

# docs 同步根目录（默认 ../tech-codex/docs；容器内为 /docs）
# KB_DOCS_ROOT=../tech-codex/docs

# CORS 允许来源（生产必填，逗号分隔；默认 http://localhost:4200）
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# 目录导入路径白名单（默认跟随 docs 同步根目录）
# KB_IMPORT_ALLOWED_ROOTS=/volume1/docker/tech-codex/docs
